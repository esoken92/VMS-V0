# ── Core (required) ──────────────────────────────────────────────
# Postgres connection — matches docker-compose defaults.
#
# ZERO-INSTALL ALTERNATIVE: leave DATABASE_URL unset (comment it out) and
# run `npm run dev:standalone` — the app falls back to an embedded PGlite
# Postgres persisted at ./.vms-data (schema + seed dataset via
# `npm run db:bootstrap`; wipe + rebuild via `npm run db:reset`).
# dev:standalone also neutralizes a set DATABASE_URL, so it works even
# with this line filled in.
# VMS_DATA_DIR=/custom/path   # override the embedded store location
DATABASE_URL=postgresql://vms:vms_local_dev@localhost:5432/vms

# docker-compose reads these for the Postgres container (defaults shown —
# only set them if you also change DATABASE_URL to match):
# POSTGRES_USER=vms  POSTGRES_PASSWORD=vms_local_dev  POSTGRES_DB=vms

# Auth.js session secret — generate: openssl rand -base64 32
AUTH_SECRET=replace-me-with-random-32-bytes

# App URL (local dev)
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional integrations (see docs/INTEGRATIONS.md) ─────────────
# All OPTIONAL — app runs fully without them. Wire up per-service.

# Email (Resend) — password resets, alert digests, scheduled reports
# RESEND_API_KEY=
# EMAIL_FROM=VMS <noreply@yourdomain.com>

# AI features (OpenAI-compatible) — NL query, datasheet→product
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# MCP server auth (optional hardening for network exposure)
# MCP_API_KEY_SALT=

# Sensor ingestion — Bearer key for device/bridge POSTs to /api/sensors/ingest
# (session auth also accepted for staff+; unset = Bearer path always denies)
# SENSOR_API_KEY=

# Scan label signing — HMAC key for printed-label payload verification
# LABEL_SIGNING_SECRET=
# LABEL_TTL_SECONDS=15552000   # label token lifetime — default 180 days, min 60

# Object storage (product photos, attachments) — local FS default
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=./storage
# S3_ENDPOINT=  S3_BUCKET=  S3_ACCESS_KEY=  S3_SECRET_KEY=

# Telemetry — NEVER on by default
# ENABLE_TELEMETRY=false

# Debugging
# VMS_DB_DEBUG=1   # log every SQL statement in embedded (PGlite) mode
